{
  "name": "formis-monitor-dashboard",
  "version": "0.1.0",
  "productName": "Formis Painel",
  "main": "src/electron.js",
  "scripts": {
    "start": "electron .",
    "dev": "node --watch src/index.js",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "br.com.formis.monitor.dashboard",
    "productName": "Formis Painel",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": true }
  }
}
